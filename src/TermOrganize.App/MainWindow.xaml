<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TermOrganize.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Term Organize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Padding="16,0,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionSpacer" Width="138" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Term Organize" VerticalAlignment="Center" FontSize="12" FontWeight="Normal" />
            <ComboBox x:Name="TermPicker" Grid.Column="1" MinWidth="120" MaxWidth="320" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" PlaceholderText="Term" SelectionChanged="TermChanged" />
            <Button Grid.Column="2" Content="Theme" Click="ToggleTheme" VerticalAlignment="Center" Margin="0,0,8,0" />
        </Grid>

        <MenuBar Grid.Row="1" VerticalAlignment="Top">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="New Schedule" Click="MenuNewSchedule" />
                <MenuFlyoutItem Text="New Degree Plan" Click="MenuNewDegree" />
                <MenuFlyoutItem Text="Import Degree Plan…" Click="MenuImport" />
                <MenuFlyoutItem Text="Export" Click="MenuExport" />
                <MenuFlyoutItem Text="Print…" Click="MenuPrint" />
            </MenuBarItem>
            <MenuBarItem Title="View">
                <MenuFlyoutItem Text="Search" Click="MenuSearch" />
                <MenuFlyoutItem Text="Subjects" Click="MenuSubjects" />
                <MenuFlyoutItem Text="Saved" Click="MenuSaved" />
                <MenuFlyoutItem Text="Professors" Click="MenuProfessors" />
                <MenuFlyoutItem Text="Free Rooms" Click="MenuRooms" />
                <MenuFlyoutItem Text="Schedules" Click="MenuSchedules" />
                <MenuFlyoutItem Text="Degree Plans" Click="MenuDegree" />
                <MenuFlyoutItem Text="Watchlist" Click="MenuWatch" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Reload" Click="MenuReload" />
                <MenuFlyoutItem Text="Show or Hide Sidebar" Click="MenuPane" />
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="Settings" Click="MenuSettings" />
            </MenuBarItem>
        </MenuBar>

        <NavigationView
            x:Name="Nav"
            Grid.Row="2"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Auto"
            SelectionChanged="NavChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Search" Tag="search" />
                <NavigationViewItem Content="Subjects" Tag="subjects" />
                <NavigationViewItem Content="Saved" Tag="saved" />
                <NavigationViewItem Content="Professors" Tag="professors" />
                <NavigationViewItem Content="Free Rooms" Tag="rooms" />
                <NavigationViewItem Content="Schedules" Tag="schedules" />
                <NavigationViewItem Content="Degree Plans" Tag="degree" />
                <NavigationViewItem Content="Watchlist" Tag="watch" />
            </NavigationView.MenuItems>
            <Grid x:Name="Host" />
        </NavigationView>

        <TextBlock x:Name="Disclaimer" Grid.Row="3" Margin="16,8" TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
    </Grid>
</Window>
