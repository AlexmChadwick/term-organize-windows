<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows, and a Linux check with -p:EnableWindowsTargeting=true, compile the shell.
       A plain Linux build of the solution keeps the empty stub below. -->
  <PropertyGroup>
    <IsWindowsBuild Condition="$([MSBuild]::IsOSPlatform('Windows')) or '$(EnableWindowsTargeting)' == 'true'">true</IsWindowsBuild>
    <IsWindowsBuild Condition="'$(IsWindowsBuild)' == ''">false</IsWindowsBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsWindowsBuild)' == 'true'">
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>TermOrganize</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationTitle>Term Organize</ApplicationTitle>
    <Description>Unofficial Northeastern course search, schedules, and degree plans.</Description>
    <Version>1.0.0</Version>
    <Authors>Term Organize contributors</Authors>
    <AssemblyName>TermOrganize.App</AssemblyName>
    <WindowsAppSDKBackgroundTask>true</WindowsAppSDKBackgroundTask>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>TermOrganize.Program</StartupObject>
    <PackageCertificateKeyFile Condition="'$(PackageCertificateKeyFile)' == '' and Exists('TermOrganize.pfx')">TermOrganize.pfx</PackageCertificateKeyFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);NonWindowsXamlStubs.cs;obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Generated .g.i.cs files are added again by the markup compiler from the
       active intermediate directory. Anything already sitting under this
       project's obj or bin, including the other package type's output, is not
       source. -->
  <ItemGroup>
    <Compile Remove="obj/**;bin/**" />
    <Page Remove="obj/**;bin/**" />
    <ApplicationDefinition Remove="obj/**;bin/**" />
    <None Remove="obj/**;bin/**" />
    <PRIResource Remove="obj/**;bin/**" />
  </ItemGroup>

  <!-- The markup compiler and MSIX tools are Windows executables. On Linux the
       same C# still compiles against the Windows App SDK reference assemblies.
       NonWindowsXamlStubs.cs supplies InitializeComponent and the x:Name fields
       the markup compiler would have generated. -->
  <PropertyGroup Condition="'$(EnableWindowsTargeting)' == 'true' and !$([MSBuild]::IsOSPlatform('Windows'))">
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackage>false</AppxPackage>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultXamlItems>false</EnableDefaultXamlItems>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <AppxGeneratePrisForPortableLibrariesEnabled>false</AppxGeneratePrisForPortableLibrariesEnabled>
  </PropertyGroup>

  <!-- windows-latest does not have the Windows App SDK runtime installed.
       An unpackaged publish carries it, and must not call the framework bootstrap.
       MSIX tooling stays on so makepri indexes App.xaml and MainWindow.xbf.
       Single-file publish and trimming drop that payload, so both stay off.
       MSIX builds keep the framework package. -->
  <PropertyGroup Condition="'$(WindowsPackageType)' == 'None' and $([MSBuild]::IsOSPlatform('Windows')) and '$(RuntimeIdentifier)' != ''">
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DisableEmbeddedXbf>false</DisableEmbeddedXbf>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsWindowsBuild)' != 'true'">
    <TargetFramework>net9.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsWindowsBuild)' == 'true'">
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
    <ProjectReference Include="..\TermOrganize.Core\TermOrganize.Core.csproj" />
    <Content Include="..\TermOrganize.Core\Catalog\term-202710.json.gz" Link="Catalog\term-202710.json.gz" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\TermOrganize.Core\Catalog\term-202710.catalog" Link="Catalog\term-202710.catalog" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.png" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- C++ copies this DLL from the native targets. The managed SDK does not,
       and MakeAppx requires the manifest Path to exist at the package root.
       Foundation 1.8.260803002 is the version WindowsAppSDK 1.8.260921001 pulls in.
       The Pkg* property is only generated for direct PackageReferences. -->
  <PropertyGroup Condition="'$(IsWindowsBuild)' == 'true' and '$(WindowsAppSDKBackgroundTask)' == 'true'">
    <UniversalBGTaskArchitecture>$([System.String]::Copy('$(Platform)').ToLowerInvariant())</UniversalBGTaskArchitecture>
    <UniversalBGTaskDll Condition="'$(PkgMicrosoft_WindowsAppSDK_Foundation)' != ''">$(PkgMicrosoft_WindowsAppSDK_Foundation)/runtimes/win-$(UniversalBGTaskArchitecture)/native/Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.dll</UniversalBGTaskDll>
    <UniversalBGTaskDll Condition="!Exists('$(UniversalBGTaskDll)')">$(NuGetPackageRoot)/microsoft.windowsappsdk.foundation/1.8.260803002/runtimes/win-$(UniversalBGTaskArchitecture)/native/Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.dll</UniversalBGTaskDll>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsWindowsBuild)' == 'true' and Exists('$(UniversalBGTaskDll)')">
    <Content Include="$(UniversalBGTaskDll)" Link="Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <AppxPackagePayload Include="$(UniversalBGTaskDll)">
      <TargetPath>Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.dll</TargetPath>
    </AppxPackagePayload>
  </ItemGroup>

  <Target Name="RequireUniversalBackgroundTaskDll"
          BeforeTargets="_ComputeAppxPackagePayload"
          Condition="'$(AppxPackage)' == 'true' and '$(WindowsAppSDKBackgroundTask)' == 'true'">
    <Error Condition="!Exists('$(UniversalBGTaskDll)')"
           Text="Windows App SDK background task DLL was not found at '$(UniversalBGTaskDll)'. Package.appxmanifest declares it at the package root." />
  </Target>

  <ItemGroup Condition="'$(EnableWindowsTargeting)' == 'true' and !$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Include="NonWindowsXamlStubs.cs" />
    <Page Remove="**\*.xaml" />
    <ApplicationDefinition Remove="**\*.xaml" />
  </ItemGroup>

  <Target Name="BuildOnNonWindows" Condition="'$(IsWindowsBuild)' != 'true'" />

  <Target Name="RejectProjectOutputSources" BeforeTargets="CoreCompile" Condition="'$(IsWindowsBuild)' == 'true'">
    <PropertyGroup>
      <_ProjectObj>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'obj'))</_ProjectObj>
      <_ProjectBin>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'bin'))</_ProjectBin>
      <!-- A rooted intermediate path replaces the project directory. A relative one is joined to it. -->
      <_ActiveIntermediate>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)'))</_ActiveIntermediate>
      <_ProjectObj>$([System.String]::Copy('$(_ProjectObj)').ToLowerInvariant())</_ProjectObj>
      <_ProjectBin>$([System.String]::Copy('$(_ProjectBin)').ToLowerInvariant())</_ProjectBin>
      <_ActiveIntermediate>$([System.String]::Copy('$(_ActiveIntermediate)').ToLowerInvariant())</_ActiveIntermediate>
    </PropertyGroup>
    <!-- AssemblyInfo and GlobalUsings live in the active intermediate directory and
         are supposed to be compiled. XAML .g.i.cs from the other package type's
         obj tree is not. -->
    <ItemGroup>
      <_StrayGenerated Include="@(Compile)"
                       Condition="$([System.String]::Copy('%(Filename)').EndsWith('.g.i')) and !$([System.String]::Copy('%(FullPath)').ToLowerInvariant().StartsWith('$(_ActiveIntermediate)')) and ($([System.String]::Copy('%(FullPath)').ToLowerInvariant().StartsWith('$(_ProjectObj)')) or $([System.String]::Copy('%(FullPath)').ToLowerInvariant().StartsWith('$(_ProjectBin)')))" />
      <_StrayGenerated Include="@(Page);@(ApplicationDefinition)"
                       Condition="!$([System.String]::Copy('%(FullPath)').ToLowerInvariant().StartsWith('$(_ActiveIntermediate)')) and ($([System.String]::Copy('%(FullPath)').ToLowerInvariant().StartsWith('$(_ProjectObj)')) or $([System.String]::Copy('%(FullPath)').ToLowerInvariant().StartsWith('$(_ProjectBin)')))" />
    </ItemGroup>
    <Error Condition="'@(_StrayGenerated)' != ''"
           Text="Generated XAML sources from another output directory are being compiled again: @(_StrayGenerated)" />
  </Target>

  <!-- Unpackaged makepri reads PriOutputs (MSIX packaging reads PackagingOutputs).
       An incremental publish can leave both lists without the .xbf files, which
       produces a few-kilobyte index and a XamlParseException. Put every project
       .xbf into both lists, then copy the files next to the exe. The loader
       accepts resources.pri or <AssemblyName>.pri. -->
  <Target Name="IndexCompiledXamlInPri"
          BeforeTargets="_GenerateProjectPriConfigurationFiles"
          Condition="'$(WindowsPackageType)' == 'None' and $([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <_ProjectXamlFile Include="@(ApplicationDefinition->'%(Filename).xbf')" />
      <_ProjectXamlFile Include="@(Page->'%(Filename).xbf')" />
      <_DiskXaml Include="$(IntermediateOutputPath)%(_ProjectXamlFile.Identity)" />
      <_DiskXaml Remove="@(_DiskXaml)" Condition="!Exists('%(Identity)')" />
      <_IndexedXamlNames Include="@(PriOutputs->'%(Filename)%(Extension)')" Condition="'%(Extension)' == '.xbf'" />
      <_IndexedXamlNames Include="@(PackagingOutputs->'%(Filename)%(Extension)')" Condition="'%(Extension)' == '.xbf'" />
    </ItemGroup>
    <PropertyGroup>
      <_IndexedXamlList>;@(_IndexedXamlNames);</_IndexedXamlList>
      <_DiskXamlList>;@(_DiskXaml->'%(Filename)%(Extension)');</_DiskXamlList>
    </PropertyGroup>
    <ItemGroup>
      <_DiskXaml Include="$(OutputPath)%(_ProjectXamlFile.Identity)"
                 Condition="Exists('$(OutputPath)%(_ProjectXamlFile.Identity)') and !$([System.String]::Copy('$(_DiskXamlList)').Contains(';%(Filename)%(Extension);'))" />
      <_DiskXaml Remove="@(_DiskXaml)"
                 Condition="$([System.String]::Copy('$(_IndexedXamlList)').Contains(';%(Filename)%(Extension);'))" />
    </ItemGroup>
    <PropertyGroup>
      <_FinalXamlList>;@(_DiskXaml->'%(Filename)%(Extension)');@(_IndexedXamlNames);</_FinalXamlList>
    </PropertyGroup>
    <Error Condition="!$([System.String]::Copy('$(_FinalXamlList)').Contains(';%(Identity);'))"
           Text="Compiled XAML %(_ProjectXamlFile.Identity) was not produced under '$(IntermediateOutputPath)' or '$(OutputPath)'. The unpackaged app cannot load its window." />
    <Message Importance="high" Text="Indexing compiled XAML into the unpackaged PRI: @(_DiskXaml). Already indexed: @(_IndexedXamlNames)." />
    <ItemGroup Condition="'@(_DiskXaml)' != ''">
      <PriOutputs Include="@(_DiskXaml)">
        <OutputGroup>EmbedOutputGroupForPackaging</OutputGroup>
        <ProjectName>$(ProjectName)</ProjectName>
        <TargetPath>%(Filename)%(Extension)</TargetPath>
      </PriOutputs>
      <PackagingOutputs Include="@(_DiskXaml)">
        <OutputGroup>EmbedOutputGroupForPackaging</OutputGroup>
        <ProjectName>$(ProjectName)</ProjectName>
        <TargetPath>%(Filename)%(Extension)</TargetPath>
      </PackagingOutputs>
    </ItemGroup>
    <Delete Files="$(ProjectPriFullPath)" Condition="'$(ProjectPriFullPath)' != '' and Exists('$(ProjectPriFullPath)')" />
    <Delete Files="$(_PriConfigXmlPath);$(_FilteredLayoutResfilesPath);$(_ResourcesResfilesPath);$(_PriResfilesPath);$(_EmbedFileResfilePath)" />
  </Target>

  <Target Name="PublishCompiledXaml"
          AfterTargets="Publish"
          Condition="'$(WindowsPackageType)' == 'None' and $([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <_ProjectXamlFile Include="@(ApplicationDefinition->'%(Filename).xbf')" />
      <_ProjectXamlFile Include="@(Page->'%(Filename).xbf')" />
      <_PublishXaml Include="$(IntermediateOutputPath)%(_ProjectXamlFile.Identity)" />
      <_PublishXaml Remove="@(_PublishXaml)" Condition="!Exists('%(Identity)')" />
    </ItemGroup>
    <PropertyGroup>
      <_PublishXamlNames>;@(_PublishXaml->'%(Filename)%(Extension)');</_PublishXamlNames>
    </PropertyGroup>
    <ItemGroup>
      <_PublishXaml Include="$(OutputPath)%(_ProjectXamlFile.Identity)"
                   Condition="Exists('$(OutputPath)%(_ProjectXamlFile.Identity)') and !$([System.String]::Copy('$(_PublishXamlNames)').Contains(';%(Filename)%(Extension);'))" />
    </ItemGroup>
    <PropertyGroup>
      <_PublishXamlNames>;@(_PublishXaml->'%(Filename)%(Extension)');</_PublishXamlNames>
    </PropertyGroup>
    <Error Condition="!$([System.String]::Copy('$(_PublishXamlNames)').Contains(';%(Identity);'))"
           Text="Compiled XAML %(_ProjectXamlFile.Identity) was not produced. The unpackaged app cannot load its window." />
    <Copy SourceFiles="@(_PublishXaml)"
          DestinationFiles="$(PublishDir)%(Filename)%(Extension)"
          SkipUnchangedFiles="true" />
    <PropertyGroup>
      <_AppPri Condition="Exists('$(PublishDir)resources.pri')">$(PublishDir)resources.pri</_AppPri>
      <_AppPri Condition="'$(_AppPri)' == '' and Exists('$(PublishDir)$(AssemblyName).pri')">$(PublishDir)$(AssemblyName).pri</_AppPri>
    </PropertyGroup>
    <Copy SourceFiles="$(_AppPri)"
          DestinationFiles="$(PublishDir)resources.pri"
          Condition="'$(_AppPri)' != '' and !Exists('$(PublishDir)resources.pri')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_AppPri)"
          DestinationFiles="$(PublishDir)$(AssemblyName).pri"
          Condition="'$(_AppPri)' != '' and !Exists('$(PublishDir)$(AssemblyName).pri')"
          SkipUnchangedFiles="true" />
    <Error Condition="'$(_AppPri)' == ''"
           Text="Publish did not produce resources.pri or $(AssemblyName).pri." />
    <Message Importance="high" Text="Published compiled XAML: @(_PublishXaml). PRI: $(_AppPri)." />
  </Target>
</Project>
