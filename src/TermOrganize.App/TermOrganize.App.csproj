<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TermOrganize</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationTitle>Term Organize</ApplicationTitle>
    <Description>Unofficial Northeastern course search, schedules, and degree plans.</Description>
    <Version>1.0.0</Version>
    <Authors>Term Organize contributors</Authors>
    <PackageCertificateKeyFile Condition="'$(PackageCertificateKeyFile)' == '' and Exists('TermOrganize.pfx')">TermOrganize.pfx</PackageCertificateKeyFile>
  </PropertyGroup>

  <!-- The WinUI project only compiles on Windows. Linux builds of the solution skip it. -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFramework>net9.0</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
    <ProjectReference Include="..\TermOrganize.Core\TermOrganize.Core.csproj" />
    <Content Include="..\TermOrganize.Core\Catalog\term-202710.json.gz" Link="Catalog\term-202710.json.gz" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\TermOrganize.Core\Catalog\term-202710.catalog" Link="Catalog\term-202710.catalog" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.png" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <Target Name="BuildOnNonWindows" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
</Project>
