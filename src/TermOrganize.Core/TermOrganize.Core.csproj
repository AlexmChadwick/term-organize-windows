<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TermOrganize.Core</RootNamespace>
    <AssemblyName>TermOrganize.Core</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Term Organize contributors</Authors>
    <Description>Cross-platform course search, schedule, and degree-plan logic for Term Organize.</Description>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Catalog\term-202710.json.gz" CopyToOutputDirectory="PreserveNewest" Link="Catalog\term-202710.json.gz" />
    <Content Include="Catalog\term-202710.catalog" CopyToOutputDirectory="PreserveNewest" Link="Catalog\term-202710.catalog" />
    <EmbeddedResource Include="LICENSE.txt" />
  </ItemGroup>
</Project>
